      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap');\n\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: #f4f4f4; }\n\n  .backdrop {\n    display: flex;\n    min-height: 100vh;\n    align-items: center;\n    justify-content: center;\n    padding: 24px;\n    background: rgb(33 23 68 / 24%);\n    font-family: Arial, 'Noto Sans TC', sans-serif;\n    font-size: 15px;\n    line-height: normal;\n  }\n\n  .window {\n    width: min(520px, 100%);\n    max-height: calc(100vh - 48px);\n    overflow: auto;\n    padding: 24px;\n    border: 1px solid #858585;\n    border-radius: 10px;\n    color: #171717;\n    background: #fff;\n    box-shadow: 0 16px 48px rgb(0 0 0 / 25%);\n  }\n\n  .window h2 {\n    margin: 0 0 24px;\n    color: #333;\n    font-size: clamp(20px, 2vw, 28px);\n    font-weight: 700;\n    line-height: 1.3;\n    text-align: center;\n    text-shadow: 0 4px 4px rgb(0 0 0 / 24%);\n  }\n\n  form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }\n  .row {\n    display: grid;\n    grid-template-columns: minmax(100px, 0.5fr) minmax(0, 1fr);\n    align-items: center;\n    gap: 12px;\n  }\n  .row > label {\n    color: #211744;\n    font-weight: 700;\n    text-align: right;\n  }\n  .control { display: grid; min-width: 0; gap: 6px; }\n\n  input {\n    width: 100%;\n    min-width: 0;\n    min-height: 42px;\n    padding: 8px 12px;\n    border: 1px solid #767676;\n    border-radius: 24px;\n    color: #454b54;\n    background: #f8f8f8;\n    font-family: inherit;\n    font-size: 14px;\n  }\n\n  .field-help { margin: 0; color: #454b54; font-size: 13px; }\n\n  .actions {\n    display: flex;\n    justify-content: center;\n    gap: 24px;\n    margin-top: 12px;\n  }\n  .btn {\n    min-width: 108px;\n    min-height: 48px;\n    padding: 12px 20px 10px;\n    border: 2px solid #333;\n    border-radius: 7px;\n    color: #333;\n    background: #fae7e4;\n    box-shadow: 7px 7px 0 #333;\n    font-family: inherit;\n    font-size: 16px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n  .btn-primary {\n    border-color: #f2da32;\n    color: #28220b;\n    background: #ffe73f;\n    box-shadow: 4px 4px 0 #d9c52a;\n  }\n  .btn-primary:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 #d9c52a; }\n  .btn-primary:active { transform: translate(4px, 4px); box-shadow: 0 0 0 #d9c52a; }\n  .btn-secondary {\n    border-color: #313e77;\n    color: #313e77;\n    background: #fff;\n    box-shadow: none;\n  }\n\n  input:focus-visible, button:focus-visible {\n    outline: 3px solid #3655a5;\n    outline-offset: 3px;\n  }\n\n  @media (max-width: 680px) {\n    .backdrop { padding: 12px; }\n    .window { max-height: calc(100vh - 24px); padding: 16px; }\n    .row { grid-template-columns: minmax(0, 1fr); gap: 4px; }\n    .row > label { text-align: left; }\n    .actions { gap: 16px; }\n    .btn { min-width: 0; flex: 1 1 auto; }\n  }\n</style>\n<div class=\"backdrop\" data-kid=\"1\" data-name=\"page backdrop overlay\">\n<section aria-labelledby=\"member-password-title\" aria-modal=\"true\" class=\"window\" data-kid=\"1-1\" data-name=\"password change dialog window\" role=\"dialog\">\n<h2 data-kid=\"1-1-1\" data-name=\"dialog headline text\" id=\"member-password-title\">修改密碼</h2>\n<form data-kid=\"1-1-2\" data-name=\"password change form\">\n<div class=\"row\" data-kid=\"1-1-2-1\" data-name=\"current password form row\">\n<label data-kid=\"1-1-2-1-1\" data-name=\"current password field label\" for=\"current-password\">目前密碼</label>\n<div class=\"control\" data-kid=\"1-1-2-1-2\" data-name=\"current password field control\">\n<input autocomplete=\"current-password\" data-kid=\"1-1-2-1-2-1\" data-name=\"current password input field\" id=\"current-password\" required=\"\" type=\"password\"/>\n</div>\n</div>\n<div class=\"row\" data-kid=\"1-1-2-2\" data-name=\"new password form row\">\n<label data-kid=\"1-1-2-2-1\" data-name=\"new password field label\" for=\"new-password\">新密碼</label>\n<div class=\"control\" data-kid=\"1-1-2-2-2\" data-name=\"new password field control\">\n<input aria-describedby=\"new-password-help\" autocomplete=\"new-password\" data-kid=\"1-1-2-2-2-1\" data-name=\"new password input field\" id=\"new-password\" required=\"\" type=\"password\"/>\n<p class=\"field-help\" data-kid=\"1-1-2-2-2-2\" data-name=\"new password field help text\" id=\"new-password-help\">新密碼至少需要 6 個字。</p>\n</div>\n</div>\n<div class=\"row\" data-kid=\"1-1-2-3\" data-name=\"confirm password form row\">\n<label data-kid=\"1-1-2-3-1\" data-name=\"confirm password field label\" for=\"confirm-password\">確認新密碼</label>\n<div class=\"control\" data-kid=\"1-1-2-3-2\" data-name=\"confirm password field control\">\n<input autocomplete=\"new-password\" data-kid=\"1-1-2-3-2-1\" data-name=\"confirm new password input field\" id=\"confirm-password\" required=\"\" type=\"password\"/>\n</div>\n</div>\n<div class=\"actions\" data-kid=\"1-1-2-4\" data-name=\"form action buttons row\">\n<button class=\"btn btn-secondary\" data-kid=\"1-1-2-4-1\" data-name=\"cancel button\" type=\"button\">取消</button>\n<button class=\"btn btn-primary\" data-kid=\"1-1-2-4-2\" data-name=\"submit change-password button\" type=\"submit\">修改密碼</button>\n</div>\n</form>\n</section>\n</div>",
