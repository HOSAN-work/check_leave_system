      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Averia+Libre:wght@700&family=Noto+Sans+TC:wght@400;500;700&display=swap');\n\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; }\n\n  .member-page {\n    --ink: #211744;\n    --text: #454b54;\n    --muted: #626c78;\n    --paper: #faecda;\n    --sidebar: rgb(232 160 72 / 20%);\n    --active: #f9cd96;\n    --border: #858585;\n    display: grid;\n    min-height: 100vh;\n    grid-template-columns: clamp(110px, 13vw, 196px) minmax(0, 1fr);\n    color: var(--ink);\n    background: var(--paper);\n    font-family: Arial, 'Noto Sans TC', sans-serif;\n    font-size: 15px;\n    line-height: normal;\n  }\n\n  .skip-link {\n    position: fixed;\n    z-index: 10;\n    top: 12px;\n    left: 12px;\n    padding: 8px 12px;\n    transform: translateY(-160%);\n    border-radius: 4px;\n    color: #fff;\n    background: var(--ink);\n    font-size: 14px;\n    text-decoration: none;\n  }\n  .skip-link:focus { transform: translateY(0); }\n\n  .sidebar {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    min-width: 0;\n    flex-direction: column;\n    padding: 46px 8px 24px;\n    border-radius: 0 15px 15px 0;\n    background: var(--sidebar);\n  }\n  .avatar {\n    display: grid;\n    width: min(173px, 100%);\n    aspect-ratio: 1;\n    margin: 0 auto;\n    place-items: center;\n    overflow: hidden;\n    border: 1px solid var(--border);\n    border-radius: 50%;\n    background: #fff;\n  }\n  .avatar img { width: 82%; height: 86%; object-fit: contain; }\n  .nav { display: flex; flex-direction: column; gap: 13px; margin-top: 67px; }\n  .nav-link {\n    display: flex;\n    min-height: 40px;\n    align-items: center;\n    gap: 10px;\n    padding: 10px;\n    border-radius: 7px;\n    color: var(--ink);\n    font-size: 12px;\n    line-height: 1.2;\n    text-decoration: none;\n  }\n  .nav-link img { width: 20px; height: 20px; flex: 0 0 auto; }\n  .nav-link.is-section-active {\n    box-shadow: inset 3px 0 var(--ink);\n    background: var(--active);\n    font-weight: 700;\n  }\n\n  .logout-wrap {\n    position: relative;\n    display: flex;\n    width: 88px;\n    min-height: 61px;\n    flex: 0 0 auto;\n    justify-content: center;\n    margin: auto auto 32px;\n  }\n  .logout-drips {\n    position: absolute;\n    z-index: 1;\n    top: 35px;\n    left: 50%;\n    width: 75px;\n    height: 40px;\n    transform: translateX(-50%);\n    background: #0d8cff;\n    mask: url('/api/local/images/PawPuffPractice.vue/src/assets/login-drips.svg') center / 100% 100% no-repeat;\n    -webkit-mask: url('/api/local/images/PawPuffPractice.vue/src/assets/login-drips.svg') center / 100% 100% no-repeat;\n    pointer-events: none;\n  }\n  .logout {\n    position: relative;\n    z-index: 2;\n    align-self: flex-start;\n    min-width: 84px;\n    min-height: 43px;\n    padding: 6px 24px;\n    border: 0;\n    border-radius: 15px;\n    color: #171717;\n    background: #0d8cff;\n    font-family: inherit;\n    font-size: 18px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n\n  .paper {\n    position: relative;\n    min-width: 0;\n    min-height: 100vh;\n    overflow: hidden;\n    border-radius: clamp(48px, 11.8vw, 178px);\n    background: #f4f4f4;\n  }\n  .paper-texture {\n    position: absolute;\n    z-index: 0;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    pointer-events: none;\n  }\n  .content {\n    position: relative;\n    z-index: 1;\n    width: min(1205px, calc(100% - 40px));\n    margin: 0 auto;\n    padding: 32px 0 48px;\n  }\n  .content > h1 {\n    margin: 0 0 24px;\n    color: rgb(0 0 0 / 75%);\n    font-family: 'Averia Libre', 'Noto Sans TC', sans-serif;\n    font-size: clamp(26px, 2.2vw, 34px);\n    font-weight: 700;\n    line-height: 1.25;\n    text-align: center;\n    text-shadow: 0 4px 4px rgb(0 0 0 / 25%);\n  }\n\n  .member-feedback {\n    width: fit-content;\n    margin: 0 auto 24px;\n    padding: 10px 18px;\n    border: 1px solid #17653b;\n    border-radius: 8px;\n    color: #17653b;\n    background: #f1f8f3;\n    font-size: 15px;\n    font-weight: 700;\n  }\n\n  .card {\n    width: min(760px, 100%);\n    margin: 0 auto;\n    padding: clamp(24px, 4vw, 48px);\n    border: 1px solid var(--border);\n    border-radius: 30px;\n    background: rgb(255 255 255 / 86%);\n    box-shadow: 0 8px 18px rgb(0 0 0 / 14%);\n  }\n  .card-heading { display: flex; align-items: center; gap: 24px; margin-bottom: 32px; }\n  .card-heading img {\n    width: 104px;\n    height: 104px;\n    flex: 0 0 auto;\n    object-fit: contain;\n    border: 1px solid var(--border);\n    border-radius: 50%;\n    background: #fff;\n  }\n  .card-heading h2 { margin: 0 0 6px; color: #211744; font-size: 28px; line-height: 1.3; }\n  .card-heading p { margin: 0; color: var(--muted); font-size: 18px; }\n\n  .details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 24px; margin: 0; }\n  .details > div { min-width: 0; padding: 16px; border-radius: 8px; background: #f4f4f7; }\n  .details dt { margin-bottom: 6px; color: var(--muted); font-size: 14px; font-weight: 700; }\n  .details dd { margin: 0; overflow-wrap: anywhere; color: #323639; font-size: 18px; }\n\n  .actions { display: flex; justify-content: center; gap: 24px; margin-top: 32px; }\n  .comic-button {\n    display: inline-flex;\n    min-height: 42px;\n    align-items: center;\n    justify-content: center;\n    padding: 12px 20px 10px;\n    border: 2px solid #333;\n    border-radius: 5px;\n    color: #333;\n    background: #fae7e4;\n    box-shadow: 7px 7px 0 #333;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 700;\n    text-decoration: none;\n    cursor: pointer;\n  }\n  .comic-button:hover { transform: translate(2px, 2px); box-shadow: 5px 5px 0 #333; }\n  .comic-button:active { transform: translate(4px, 4px); box-shadow: 3px 3px 0 #333; }\n  .primary-action { background: #ff8177; }\n  .secondary-action { background: #fff; }\n\n  a:focus-visible, button:focus-visible {\n    outline: 3px solid #3655a5;\n    outline-offset: 3px;\n  }\n\n  @media (max-width: 680px) {\n    .member-page { display: flex; flex-direction: column; }\n    .sidebar { flex-direction: row; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 0; }\n    .avatar { width: 64px; flex: 0 0 auto; }\n    .nav { flex: 1; flex-direction: row; gap: 4px; margin: 0; overflow-x: auto; }\n    .nav-link { min-width: max-content; padding: 8px; }\n    .logout-wrap { width: 88px; flex: 0 0 88px; margin: 0; }\n    .paper { border-radius: 48px 48px 0 0; }\n    .content { width: calc(100% - 24px); padding-top: 24px; }\n    .card-heading { flex-direction: column; text-align: center; }\n    .details { grid-template-columns: minmax(0, 1fr); }\n    .actions { flex-direction: column; align-items: stretch; }\n  }\n</style>\n<div class=\"member-page\" data-kid=\"1\" data-name=\"member profile page layout\">\n<a class=\"skip-link\" data-kid=\"1-1\" data-name=\"skip to main content link\" href=\"#member-main\">跳到主要內容</a>\n<aside class=\"sidebar\" data-kid=\"1-2\" data-name=\"sidebar navigation panel\">\n<div class=\"avatar\" data-kid=\"1-2-1\" data-name=\"member avatar circle\">\n<img alt=\"\" aria-hidden=\"true\" data-kid=\"1-2-1-1\" data-name=\"member profile avatar image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/PawPuffPractice.vue/src/assets/profile.png\"/>\n</div>\n<nav aria-label=\"主要導覽\" class=\"nav\" data-kid=\"1-2-2\" data-name=\"main section navigation\">\n<a class=\"nav-link\" data-kid=\"1-2-2-1\" data-name=\"check-in feature nav link\" href=\"#\">\n<img alt=\"\" aria-hidden=\"true\" data-kid=\"1-2-2-1-1\" data-name=\"clock icon for check-in nav\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/PawPuffPractice.vue/src/assets/dashboard-nav-clock.svg\"/>打卡功能\n      </a>\n<a aria-current=\"page\" class=\"nav-link is-section-active\" data-kid=\"1-2-2-2\" data-name=\"user center nav link (active page)\" href=\"#\">\n<img alt=\"\" aria-hidden=\"true\" data-kid=\"1-2-2-2-1\" data-name=\"user icon for user center nav\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/PawPuffPractice.vue/src/assets/dashboard-nav-user.svg\"/>使用者中心\n      </a>\n</nav>\n<div class=\"logout-wrap\" data-kid=\"1-2-3\" data-name=\"logout control container\">\n<span aria-hidden=\"true\" class=\"logout-drips\" data-kid=\"1-2-3-1\" data-name=\"decorative blue drip graphic\"></span>\n<button class=\"logout\" data-kid=\"1-2-3-2\" data-name=\"logout button\" type=\"button\">登出</button>\n</div>\n</aside>\n<main class=\"paper\" data-kid=\"1-3\" data-name=\"main content area with paper background\" id=\"member-main\">\n<img alt=\"\" aria-hidden=\"true\" class=\"paper-texture\" data-kid=\"1-3-1\" data-name=\"paper texture background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/PawPuffPractice.vue/src/assets/dashboard-paper.png\"/>\n<div class=\"content\" data-kid=\"1-3-2\" data-name=\"centered content wrapper\">\n<h1 data-kid=\"1-3-2-1\" data-name=\"page title heading\">使用者中心</h1>\n<p class=\"member-feedback\" data-kid=\"1-3-2-2\" data-name=\"member data updated success status\" role=\"status\">會員資料修改成功</p>\n<section aria-labelledby=\"member-profile-title\" class=\"card\" data-kid=\"1-3-2-3\" data-name=\"member profile detail card\">\n<div class=\"card-heading\" data-kid=\"1-3-2-3-1\" data-name=\"member identity header with avatar\">\n<img alt=\"\" aria-hidden=\"true\" data-kid=\"1-3-2-3-1-1\" data-name=\"member profile picture image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/PawPuffPractice.vue/src/assets/profile.png\"/>\n<div data-kid=\"1-3-2-3-1-2\" data-name=\"member name and ID text block\">\n<h2 data-kid=\"1-3-2-3-1-2-1\" data-name=\"member display name heading\" id=\"member-profile-title\">泡芙</h2>\n<p data-kid=\"1-3-2-3-1-2-2\" data-name=\"member username text\">pawpuff01</p>\n</div>\n</div>\n<dl class=\"details\" data-kid=\"1-3-2-3-2\" data-name=\"member details grid\">\n<div data-kid=\"1-3-2-3-2-1\" data-name=\"member number detail cell\">\n<dt data-kid=\"1-3-2-3-2-1-1\" data-name=\"member number label\">會員編號</dt>\n<dd data-kid=\"1-3-2-3-2-1-2\" data-name=\"member number value\">12</dd>\n</div>\n<div data-kid=\"1-3-2-3-2-2\" data-name=\"email detail cell\">\n<dt data-kid=\"1-3-2-3-2-2-1\" data-name=\"email label\">Email</dt>\n<dd data-kid=\"1-3-2-3-2-2-2\" data-name=\"email address value\">pawpuff01@gmail.com</dd>\n</div>\n<div data-kid=\"1-3-2-3-2-3\" data-name=\"phone detail cell\">\n<dt data-kid=\"1-3-2-3-2-3-1\" data-name=\"phone label\">電話</dt>\n<dd data-kid=\"1-3-2-3-2-3-2\" data-name=\"phone number value\">0922334455</dd>\n</div>\n<div data-kid=\"1-3-2-3-2-4\" data-name=\"points detail cell\">\n<dt data-kid=\"1-3-2-3-2-4-1\" data-name=\"points label\">點數</dt>\n<dd data-kid=\"1-3-2-3-2-4-2\" data-name=\"points value\">320</dd>\n</div>\n</dl>\n<div class=\"actions\" data-kid=\"1-3-2-3-3\" data-name=\"action buttons container\">\n<button class=\"comic-button primary-action\" data-kid=\"1-3-2-3-3-1\" data-name=\"edit member info button\" type=\"button\">修改會員資料</button>\n<button class=\"comic-button secondary-action\" data-kid=\"1-3-2-3-3-2\" data-name=\"change password button\" type=\"button\">修改密碼</button>\n</div>\n</section>\n</div>\n</main>\n</div>",
