      "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap');\n\n  *, *::before, *::after { box-sizing: border-box; }\n  body { margin: 0; background: #f4f4f4; }\n\n  .backdrop {\n    display: flex;\n    min-height: 100vh;\n    align-items: center;\n    justify-content: center;\n    padding: 24px;\n    background: rgb(33 23 68 / 24%);\n    font-family: Arial, 'Noto Sans TC', sans-serif;\n    font-size: 15px;\n    line-height: normal;\n  }\n\n  .window {\n    width: min(600px, 100%);\n    max-height: calc(100vh - 48px);\n    overflow: auto;\n    padding: 24px;\n    border: 1px solid #858585;\n    border-radius: 10px;\n    color: #171717;\n    background: #fff;\n    box-shadow: 0 16px 48px rgb(0 0 0 / 25%);\n  }\n\n  .window h2 {\n    margin: 0 0 24px;\n    color: #333;\n    font-size: clamp(20px, 2vw, 28px);\n    font-weight: 700;\n    line-height: 1.3;\n    text-align: center;\n    text-shadow: 0 4px 4px rgb(0 0 0 / 24%);\n  }\n\n  form { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }\n  .row {\n    display: grid;\n    grid-template-columns: minmax(100px, 0.5fr) minmax(0, 1fr);\n    align-items: center;\n    gap: 12px;\n  }\n  .row > label {\n    color: #211744;\n    font-weight: 700;\n    text-align: right;\n  }\n  .control { display: grid; min-width: 0; gap: 6px; }\n\n  input, textarea {\n    width: 100%;\n    min-width: 0;\n    padding: 8px 12px;\n    border: 1px solid #767676;\n    border-radius: 24px;\n    color: #454b54;\n    background: #f8f8f8;\n    font-family: inherit;\n    font-size: 14px;\n  }\n  input { min-height: 42px; }\n\n  .row--wide {\n    grid-template-columns: minmax(0, 1fr);\n    align-items: start;\n    gap: 8px;\n  }\n  .row--wide > label { text-align: left; }\n  textarea {\n    min-height: 96px;\n    padding: 12px 16px;\n    border-radius: 16px;\n    line-height: 1.5;\n    resize: vertical;\n  }\n\n  .field-help { margin: 0; color: #454b54; font-size: 13px; }\n\n  .actions {\n    display: flex;\n    justify-content: center;\n    gap: 24px;\n    margin-top: 12px;\n  }\n  .btn {\n    min-width: 108px;\n    min-height: 48px;\n    padding: 12px 20px 10px;\n    border: 2px solid #333;\n    border-radius: 7px;\n    color: #333;\n    background: #fae7e4;\n    box-shadow: 7px 7px 0 #333;\n    font-family: inherit;\n    font-size: 16px;\n    font-weight: 700;\n    cursor: pointer;\n  }\n  .btn-primary {\n    border-color: #f2da32;\n    color: #28220b;\n    background: #ffe73f;\n    box-shadow: 4px 4px 0 #d9c52a;\n  }\n  .btn-primary:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 #d9c52a; }\n  .btn-primary:active { transform: translate(4px, 4px); box-shadow: 0 0 0 #d9c52a; }\n  .btn-secondary {\n    border-color: #313e77;\n    color: #313e77;\n    background: #fff;\n    box-shadow: none;\n  }\n\n  input:focus-visible, textarea:focus-visible, button:focus-visible {\n    outline: 3px solid #3655a5;\n    outline-offset: 3px;\n  }\n\n  @media (max-width: 680px) {\n    .backdrop { padding: 12px; }\n    .window { max-height: calc(100vh - 24px); padding: 16px; }\n    .row { grid-template-columns: minmax(0, 1fr); gap: 4px; }\n    .row > label { text-align: left; }\n    .actions { gap: 16px; }\n    .btn { min-width: 0; flex: 1 1 auto; }\n  }\n</style>\n<div class=\"backdrop\" data-kid=\"1\" data-name=\"modal backdrop overlay\">\n<section aria-labelledby=\"member-edit-title\" aria-modal=\"true\" class=\"window\" data-kid=\"1-1\" data-name=\"member edit dialog window\" role=\"dialog\">\n<h2 data-kid=\"1-1-1\" data-name=\"dialog headline text\" id=\"member-edit-title\">修改會員資料</h2>\n<form data-kid=\"1-1-2\" data-name=\"member profile form\">\n<div class=\"row\" data-kid=\"1-1-2-1\" data-name=\"nickname field row\">\n<label data-kid=\"1-1-2-1-1\" data-name=\"nickname field label\" for=\"member-nickname\">暱稱</label>\n<div class=\"control\" data-kid=\"1-1-2-1-2\" data-name=\"nickname input control wrapper\">\n<input autocomplete=\"nickname\" data-kid=\"1-1-2-1-2-1\" data-name=\"nickname text input\" id=\"member-nickname\" maxlength=\"50\" required=\"\" type=\"text\" value=\"泡芙\"/>\n</div>\n</div>\n<div class=\"row\" data-kid=\"1-1-2-2\" data-name=\"email field row\">\n<label data-kid=\"1-1-2-2-1\" data-name=\"email field label\" for=\"member-email\">Email</label>\n<div class=\"control\" data-kid=\"1-1-2-2-2\" data-name=\"email input control wrapper\">\n<input autocomplete=\"email\" data-kid=\"1-1-2-2-2-1\" data-name=\"email input field\" id=\"member-email\" maxlength=\"255\" required=\"\" type=\"email\" value=\"pawpuff01@example.com\"/>\n</div>\n</div>\n<div class=\"row\" data-kid=\"1-1-2-3\" data-name=\"phone field row\">\n<label data-kid=\"1-1-2-3-1\" data-name=\"phone field label\" for=\"member-phone\">電話（選填）</label>\n<div class=\"control\" data-kid=\"1-1-2-3-2\" data-name=\"phone input control wrapper\">\n<input aria-describedby=\"member-phone-help\" autocomplete=\"tel\" data-kid=\"1-1-2-3-2-1\" data-name=\"phone number input field\" id=\"member-phone\" inputmode=\"numeric\" maxlength=\"10\" pattern=\"[0-9]{10}\" placeholder=\"例如：0912345678\" type=\"tel\" value=\"0912345678\"/>\n<p class=\"field-help\" data-kid=\"1-1-2-3-2-2\" data-name=\"phone field helper text\" id=\"member-phone-help\">請輸入 10 位數字。</p>\n</div>\n</div>\n<div class=\"row row--wide\" data-kid=\"1-1-2-4\" data-name=\"bio field row\">\n<label data-kid=\"1-1-2-4-1\" data-name=\"biography field label\" for=\"member-biography\">簡介（選填）</label>\n<textarea data-kid=\"1-1-2-4-2\" data-name=\"biography textarea input\" id=\"member-biography\" maxlength=\"500\" placeholder=\"例如：平日在 3 樓辦公室，週五遠端。\">平日在 3 樓辦公室，週五遠端。</textarea>\n</div>\n<div class=\"actions\" data-kid=\"1-1-2-5\" data-name=\"form actions button bar\">\n<button class=\"btn btn-secondary\" data-kid=\"1-1-2-5-1\" data-name=\"cancel action button\" type=\"button\">取消</button>\n<button class=\"btn btn-primary\" data-kid=\"1-1-2-5-2\" data-name=\"save changes submit button\" type=\"submit\">儲存修改</button>\n</div>\n</form>\n</section>\n</div>",
